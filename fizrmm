#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_COMPOSE_FILE="$ROOT_DIR/docker-compose.yml"
cd "$ROOT_DIR"
export COMPOSE_PROGRESS="${COMPOSE_PROGRESS:-plain}"
export BUILDKIT_PROGRESS="${BUILDKIT_PROGRESS:-plain}"

usage() {
  cat <<'USAGE'
Usage: ./fizrmm [command]

App commands (use docker-compose.yml: portal + API + PostgreSQL + integrations):
  ./fizrmm                 Pull when possible, rebuild, initialize, and start FizRMM in the background
  ./fizrmm start           Same as the default command
  ./fizrmm stop            Stop app containers without deleting volumes
  ./fizrmm restart         Stop then start the app
  ./fizrmm status          Show app container status
  ./fizrmm doctor          Show failed/unhealthy services and recent error logs
  ./fizrmm logs [service]  Follow logs for all services or one service
  ./fizrmm reset           Stop app containers and delete app volumes/data

Compatibility command:
  ./fizrmm integrations    Same as start
USAGE
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is not installed or not on PATH." >&2
    exit 127
  fi
  if ! docker compose version >/dev/null 2>&1; then
    echo "Docker Compose plugin is not available." >&2
    exit 127
  fi
}

require_docker_disk_space() {
  local min_mb="${FIZRMM_MIN_DOCKER_FREE_MB:-8192}"
  local docker_root available_mb
  docker_root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
  docker_root="${docker_root:-/var/lib/docker}"
  if [ ! -e "$docker_root" ]; then
    docker_root="/"
  fi
  available_mb="$(df -Pm "$docker_root" | awk 'NR == 2 { print $4 }')"
  if [ -n "$available_mb" ] && [ "$available_mb" -lt "$min_mb" ]; then
    echo "Docker does not have enough free disk space to start the full FizRMM stack." >&2
    echo "Docker root: $docker_root" >&2
    echo "Available: ${available_mb}MB; required: ${min_mb}MB." >&2
    echo "Free space on the Docker host, then rerun ./fizrmm." >&2
    return 1
  fi
}

pull_if_possible() {
  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git pull --ff-only
  else
    echo "Skipping git pull: git is unavailable or this is not a git checkout."
  fi
}

compose() {
  docker compose -f "$APP_COMPOSE_FILE" --profile integrations "$@"
}

doctor() {
  require_docker
  echo "Container status:"
  compose ps --all
  echo

  local services
  services="$(compose ps --services 2>/dev/null || true)"
  local bad=0
  local service container state health
  for service in $services; do
    container="$(compose ps -q "$service" 2>/dev/null || true)"
    if [ -z "$container" ]; then
      echo "MISSING: $service has no container."
      bad=1
      continue
    fi
    state="$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo unknown)"
    health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container" 2>/dev/null || echo unknown)"
    if [ "$state" != "running" ] && [ "$state" != "exited" ]; then
      echo "PROBLEM: $service state=$state health=$health"
      bad=1
    elif [ "$state" = "exited" ]; then
      if [ "$service" = "fizrmm-init" ]; then
        local exit_code
        exit_code="$(docker inspect -f '{{.State.ExitCode}}' "$container" 2>/dev/null || echo 1)"
        if [ "$exit_code" != "0" ]; then
          echo "PROBLEM: $service exited with code $exit_code"
          bad=1
        fi
      else
        echo "PROBLEM: $service exited."
        bad=1
      fi
    elif [ "$health" = "unhealthy" ]; then
      echo "PROBLEM: $service is unhealthy."
      bad=1
    fi
  done

  echo
  echo "Recent warnings/errors:"
  compose logs --no-color --tail=120 2>/dev/null | grep -Ei 'error|fatal|panic|exception|traceback|failed|unhealthy|permission denied|timed out|not reachable|insufficient|warning' | tail -n 80 || true

  if [ "$bad" -ne 0 ]; then
    echo
    echo "FizRMM startup has failed or degraded services. Use './fizrmm logs <service>' for one service."
    return 1
  fi
}

run_app() {
  require_docker
  pull_if_possible
  require_docker_disk_space
  compose down --remove-orphans
  COMPOSE_PARALLEL_LIMIT=1 compose build api
  COMPOSE_PARALLEL_LIMIT=1 compose build portal
  COMPOSE_PARALLEL_LIMIT=1 compose build salt-master
  COMPOSE_PARALLEL_LIMIT=1 compose build keycloak

  echo "Starting FizRMM integration services."
  if ! COMPOSE_PARALLEL_LIMIT=1 compose up --build -d \
    postgres \
    keycloak \
    nats \
    meshcentral \
    salt-master \
    zabbix-postgres \
    zabbix-server \
    zabbix-web \
    opensearch \
    wazuh-manager; then
    echo
    echo "FizRMM startup failed while starting integration services."
    doctor || true
    return 1
  fi

  echo
  echo "Running FizRMM integration initialization."
  if ! COMPOSE_PARALLEL_LIMIT=1 compose up --no-build fizrmm-init; then
    echo
    echo "FizRMM startup failed during integration initialization."
    doctor || true
    return 1
  fi
  local init_container init_exit_code
  init_container="$(compose ps -q fizrmm-init 2>/dev/null || true)"
  init_exit_code="$(docker inspect -f '{{.State.ExitCode}}' "$init_container" 2>/dev/null || echo 1)"
  if [ "$init_exit_code" != "0" ]; then
    echo
    echo "FizRMM startup failed: fizrmm-init exited with code $init_exit_code."
    doctor || true
    return 1
  fi

  echo
  echo "Starting FizRMM API and portal."
  if ! COMPOSE_PARALLEL_LIMIT=1 compose up --no-build -d api portal; then
    echo
    echo "FizRMM startup failed while starting API and portal."
    doctor || true
    return 1
  fi
  echo
  echo "FizRMM is starting in the background."
  echo "Portal: http://127.0.0.1:5173/"
  echo "API health: http://127.0.0.1:8000/health"
  echo
  doctor
  echo
  echo "Use './fizrmm logs [service]' only when you need logs."
}

start_app() {
  run_app
}

stop_app() {
  require_docker
  compose down --remove-orphans
}

case "${1:-start}" in
  start|up|install|update)
    run_app
    ;;
  stop|down)
    stop_app
    ;;
  restart)
    stop_app
    start_app
    ;;
  status|ps)
    require_docker
    compose ps
    ;;
  doctor)
    doctor
    ;;
  logs)
    require_docker
    compose logs -f "${@:2}"
    ;;
  reset)
    require_docker
    compose down --volumes --remove-orphans
    ;;
  integrations)
    run_app
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
